RAILS_ENV=production
APP_HOST=prompt-validator-project.onrender.com
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

PERPLEXITY_API_KEY=
