<% content_for :title, "AI Prompt Coach" %>
<% content_for :nav_cta, "Work with me" %>

<main class="px-4 pb-16 pt-9 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <header class="mx-auto max-w-4xl text-center">
      <h1 class="font-mono text-4xl font-black leading-tight tracking-[-0.08em] text-slate-950 sm:text-5xl lg:text-6xl">
        Write <span class="text-blue-600">AI Coding Prompts</span><br>
        That Actually Work
      </h1>
      <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 font-mono text-xs font-semibold text-blue-700">
        <span class="size-2 rounded-full bg-blue-500"></span>
        10,468 prompts tested
      </div>
      <p class="mx-auto mt-7 max-w-2xl text-base text-slate-600 sm:text-lg">
        14 proven principles. Straight from <span class="font-semibold text-slate-800">OpenAI</span> and <span class="font-semibold text-slate-800 underline decoration-slate-400 underline-offset-4">Anthropic</span> research teams.
      </p>
      <div class="mt-7 flex items-center justify-center gap-9 text-sm font-semibold text-slate-500">
        <span class="inline-flex items-center gap-2">
          <span class="grid size-6 place-items-center rounded-full border border-slate-300 font-mono text-xs">O</span>
          OpenAI
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="font-mono text-xl font-black">AI</span>
          Anthropic
        </span>
      </div>
    </header>

    <section class="mx-auto mt-12 max-w-4xl" data-controller="prompt-form">
      <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
          <div class="flex items-center gap-3">
            <span class="flex items-center gap-1.5">
              <span class="size-3 rounded-full bg-rose-500"></span>
              <span class="size-3 rounded-full bg-amber-400"></span>
              <span class="size-3 rounded-full bg-emerald-500"></span>
            </span>
            <h2 class="font-mono text-sm font-bold text-slate-900">Prompt Editor</h2>
          </div>
          <span class="font-mono text-xs text-slate-500" data-prompt-form-target="count">
            <%= PromptAnalysis::MIN_PROMPT_LENGTH %> more needed
          </span>
        </div>

        <% if @prompt_analysis.errors.any? %>
          <div class="m-4 rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
            <p class="font-semibold">Please fix the following:</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              <% @prompt_analysis.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @prompt_analysis, url: prompt_analyses_path, id: "prompt-analysis-form" do |form| %>
          <div class="p-4">
            <%= form.text_area :prompt_text,
              rows: 7,
              placeholder: "// Enter your prompt here...",
              data: { prompt_form_target: "input", action: "input->prompt-form#updateCount" },
              class: "min-h-44 w-full resize-y border-0 bg-white p-2 font-mono text-sm leading-7 text-slate-800 outline-none ring-0 placeholder:text-slate-300 focus:ring-0" %>
          </div>

          <div class="border-t border-slate-100 px-4 py-5 text-center">
            <%= form.submit "Analyze My Prompt", class: "cursor-pointer rounded-lg bg-blue-500 px-8 py-3 font-mono text-xs font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-600" %>
          </div>

          <div class="grid gap-3 border-t border-slate-100 bg-white px-4 py-4 md:grid-cols-[minmax(220px,0.8fr)_1fr_1fr]">
            <label class="relative">
              <span class="sr-only">Model</span>
              <%= form.select :ai_model,
                options_for_select([["Groq Llama 3.1 8B", "llama-3.1-8b-instant"], ["Groq Llama 3.3 70B", "llama-3.3-70b-versatile"], ["Groq Gemma 2 9B", "gemma2-9b-it"]], @prompt_analysis.ai_model),
                {},
                class: "w-full rounded-md border border-slate-200 bg-white px-3 py-3 pr-16 font-mono text-xs font-semibold text-slate-900 outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" %>
              <span class="pointer-events-none absolute right-9 top-1/2 -translate-y-1/2 rounded bg-emerald-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-emerald-600">FREE</span>
            </label>

            <label class="flex items-center gap-3 rounded-md bg-white px-2 py-3 text-sm font-medium text-slate-500">
              <%= form.check_box :web_search, class: "size-4 rounded border-slate-300 bg-white text-blue-600 focus:ring-blue-500" %>
              Web search with Perplexity
            </label>

            <label class="flex items-center gap-3 rounded-md bg-white px-2 py-3 text-sm font-medium text-slate-500">
              <%= form.check_box :shared, checked: @prompt_analysis.shared != false, class: "size-4 rounded border-slate-300 bg-white text-blue-600 focus:ring-blue-500" %>
              Share my prompt to help others
            </label>
          </div>
        <% end %>
      </div>

      <p class="mt-4 text-center text-xs text-slate-500">Results take up to 20-30 seconds to generate.</p>
    </section>

    <section class="mx-auto mt-16 max-w-4xl">
      <h2 class="text-center font-mono text-2xl font-black tracking-[-0.05em] text-slate-950">Try Example Prompts</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <% @examples.first(2).each do |example| %>
          <button type="button"
            class="overflow-hidden rounded-lg border border-slate-200 bg-white text-left shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md"
            data-action="prompt-form#useExample"
            data-prompt-form-prompt-param="<%= example.prompt_text %>"
            form="prompt-analysis-form">
            <span class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
              <span class="font-mono text-sm font-bold text-slate-900"><%= example.title %></span>
              <% if example.score.present? %>
                <span class="rounded px-2 py-1 font-mono text-xs font-bold <%= score_badge_class(example.score) %>"><%= number_with_precision(example.score, precision: 1) %></span>
              <% end %>
            </span>
            <span class="line-clamp-4 block p-5 font-mono text-sm leading-7 text-slate-500"><%= example.prompt_text %></span>
          </button>
        <% end %>
      </div>
    </section>

    <section class="mx-auto mt-16 max-w-4xl">
      <h2 class="mb-6 text-center font-mono text-2xl font-black tracking-[-0.05em] text-slate-950">Recently Tested Prompts</h2>
      <%= render "prompt_analyses/recent_grid", analyses: @recent_analyses %>
    </section>
  </div>
</main>
