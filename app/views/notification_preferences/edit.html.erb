<% content_for :title, "Notifications" %>
<% content_for :nav_cta, "My work" %>

<main class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <header>
      <h1 class="font-mono text-2xl font-black tracking-[-0.05em] text-slate-950">Notifications</h1>
      <p class="mt-2 text-sm text-slate-600">Email digests, instant completion alerts, and Slack webhooks for your prompt coaching.</p>
    </header>

    <% if notice.present? %>
      <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800"><%= notice %></div>
    <% end %>

    <div class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <% if @preference.errors.any? %>
        <div class="m-4 rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
          <ul class="list-disc space-y-1 pl-5">
            <% @preference.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @preference, url: notification_preference_path, method: :patch do |form| %>
        <div class="space-y-6 p-6">
          <div class="grid gap-2">
            <%= form.label :email, "Email", class: "text-sm font-semibold text-slate-700" %>
            <%= form.email_field :email, placeholder: "you@example.com", class: "w-full rounded-md border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" %>
            <p class="text-xs text-slate-500">Used for digests and completion emails. Also links sessions across devices.</p>
          </div>

          <div class="grid gap-2">
            <%= form.label :digest_frequency, "Email digest", class: "text-sm font-semibold text-slate-700" %>
            <%= form.select :digest_frequency,
              options_for_select([["Off", "none"], ["Daily (9am UTC)", "daily"], ["Weekly (Monday 9am UTC)", "weekly"]], @preference.digest_frequency),
              {},
              class: "w-full rounded-md border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" %>
          </div>

          <label class="flex items-center gap-3 text-sm font-medium text-slate-600">
            <%= form.check_box :notify_on_complete, class: "size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
            Email me when each analysis finishes
          </label>

          <div class="grid gap-2">
            <%= form.label :slack_webhook_url, "Slack webhook URL (optional)", class: "text-sm font-semibold text-slate-700" %>
            <%= form.url_field :slack_webhook_url, placeholder: "https://hooks.slack.com/services/...", class: "w-full rounded-md border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" %>
            <p class="text-xs text-slate-500">Digests are posted to Slack when a webhook URL is set (in addition to email).</p>
          </div>
        </div>

        <div class="border-t border-slate-100 bg-slate-50 px-6 py-4 flex justify-between">
          <%= link_to "Back", prompt_sessions_path, class: "rounded-md border border-slate-200 bg-white px-4 py-2 font-mono text-xs font-bold text-slate-700 transition hover:bg-slate-50" %>
          <%= form.submit "Save settings", class: "cursor-pointer rounded-lg bg-blue-600 px-6 py-2 font-mono text-xs font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>

    <% unless ENV["SMTP_ADDRESS"].present? %>
      <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        <p class="font-semibold">SMTP not configured</p>
        <p class="mt-1">Email notifications are disabled until you set <code class="rounded bg-amber-100 px-1">SMTP_*</code> variables. Slack webhooks still work.</p>
      </div>
    <% end %>
  </div>
</main>
