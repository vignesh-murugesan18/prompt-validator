<section class="rounded-3xl border border-white/10 bg-white/10 p-5 backdrop-blur">
  <h2 class="text-xl font-bold text-white"><%= title %></h2>

  <% if analyses.any? %>
    <div class="mt-4 space-y-3">
      <% analyses.each do |analysis| %>
        <%= link_to prompt_analysis_path(analysis), class: "block rounded-2xl border border-white/10 bg-slate-950/70 p-4 transition hover:border-cyan-300/60 hover:bg-slate-900" do %>
          <span class="flex items-start justify-between gap-3">
            <span class="line-clamp-2 text-sm leading-6 text-slate-200"><%= analysis.prompt_preview(150) %></span>
            <span class="rounded-full bg-cyan-300/15 px-2.5 py-1 text-xs font-bold text-cyan-200"><%= number_with_precision(analysis.score, precision: 1) %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 rounded-2xl border border-dashed border-white/10 p-4 text-sm text-slate-400"><%= empty %></p>
  <% end %>
</section>
