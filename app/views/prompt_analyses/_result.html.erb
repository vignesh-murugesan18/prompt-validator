<div data-status="<%= prompt_analysis.status %>">
  <% if prompt_analysis.completed? %>
    <article class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1.5">
            <span class="size-3 rounded-full bg-rose-500"></span>
            <span class="size-3 rounded-full bg-amber-400"></span>
            <span class="size-3 rounded-full bg-emerald-500"></span>
          </span>
          <h1 class="line-clamp-1 font-mono text-sm font-bold text-slate-900"><%= prompt_analysis.prompt_preview(42) %></h1>
        </div>
        <%= link_to "New Prompt", root_path, class: "rounded-md border border-blue-300 px-4 py-2 font-mono text-xs font-bold text-blue-600 transition hover:bg-blue-50" %>
      </div>

      <div class="p-6" data-controller="prompt-form">
        <div class="flex flex-col gap-4 md:flex-row md:items-center">
          <div class="inline-flex w-fit items-end rounded-xl <%= score_panel_class(prompt_analysis.score) %> px-5 py-4 font-mono">
            <span class="text-5xl font-black leading-none"><%= number_with_precision(prompt_analysis.score, precision: 1) %></span>
            <span class="pb-1 text-xl font-bold">/10</span>
          </div>
          <div class="flex-1">
            <div class="grid grid-cols-10 gap-1">
              <% 10.times do |index| %>
                <span class="h-3 rounded-sm <%= score_segment_class(index + 1, prompt_analysis.score) %>"></span>
              <% end %>
            </div>
            <p class="mt-4 text-xs font-bold uppercase tracking-wide text-slate-500">Overall Feedback</p>
            <p class="mt-2 text-base leading-7 text-slate-800"><%= prompt_analysis.summary %></p>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <button type="button"
                class="rounded-md border border-slate-200 bg-white px-3 py-2 font-mono text-[11px] font-bold text-slate-700 transition hover:bg-slate-50"
                data-action="prompt-form#readSummary"
                data-prompt-form-text-param="<%= prompt_analysis.summary.to_s %>">
                Listen to summary
              </button>
            </div>
            <p class="mt-3 font-mono text-xs text-slate-400">
              <%= time_ago_in_words(prompt_analysis.updated_at) %> ago · <%= prompt_analysis.ai_model %>
            </p>
          </div>
        </div>
      </div>
    </article>

    <section class="mt-6 overflow-hidden rounded-lg border border-blue-500 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-blue-500 bg-blue-50 px-4 py-3">
        <svg class="size-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="14" height="10" x="5" y="11" rx="2" />
          <path d="M8 11V8a4 4 0 0 1 8 0v3" />
        </svg>
      </div>
      <div class="relative p-5">
        <p class="whitespace-pre-wrap font-mono text-sm leading-7 text-slate-700"><%= prompt_analysis.prompt_text %></p>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white to-white/0"></div>
      </div>
    </section>

    <section class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <h2 class="border-b border-slate-200 px-5 py-4 font-mono text-sm font-bold text-slate-900">How Did Your Prompt Do?</h2>
      <div class="divide-y divide-slate-100 bg-white">
        <% prompt_principle_rows(prompt_analysis).each_with_index do |row, index| %>
          <details class="group open:ring-1 open:ring-inset open:ring-blue-500" <%= "open" if index.zero? %>>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-3.5 transition hover:bg-slate-50">
              <span class="font-sans text-sm font-semibold text-slate-950"><%= row[:label] %></span>
              <span class="flex items-center gap-4">
                <span class="<%= score_badge_class(row[:score]) %> rounded-md px-2.5 py-1 font-mono text-xs font-black"><%= number_with_precision(row[:score], precision: 1) %></span>
                <svg class="size-4 text-slate-500 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                </svg>
              </span>
            </summary>
            <div class="border-l-2 border-rose-300 pb-5 pl-4 pr-5 sm:ml-5">
              <p class="text-sm leading-6 text-slate-500"><%= row[:feedback] %></p>
              <% if (suggestion = prompt_principle_suggestion(row)).present? %>
                <p class="mt-4 flex gap-3 text-sm leading-6 text-slate-900">
                  <span class="font-mono text-lg leading-5 text-blue-500">-&gt;</span>
                  <span><%= suggestion %></span>
                </p>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </section>

    <turbo-frame id="<%= dom_id(prompt_analysis, :rewrites) %>">
      <% rewrite = prompt_analysis.prompt_rewrites.find_by(strategy: "default") %>
      <%= render "prompt_rewrites/panel", prompt_analysis: prompt_analysis, rewrite: rewrite %>
    </turbo-frame>
  <% elsif prompt_analysis.failed? %>
    <div class="rounded-lg border border-rose-200 bg-white p-6 shadow-sm">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-rose-500">Analysis Failed</p>
      <h2 class="mt-3 text-2xl font-black text-slate-950">We could not analyze this prompt.</h2>
      <p class="mt-3 text-slate-600"><%= prompt_analysis.error_message.presence || "Please try again." %></p>
      <%= link_to "Try a new prompt", root_path, class: "mt-5 inline-flex rounded-lg bg-blue-600 px-5 py-3 font-mono text-xs font-bold text-white hover:bg-blue-700" %>
    </div>
  <% else %>
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1.5">
            <span class="size-3 rounded-full bg-rose-500"></span>
            <span class="size-3 rounded-full bg-amber-400"></span>
            <span class="size-3 rounded-full bg-emerald-500"></span>
          </span>
          <h1 class="font-mono text-sm font-bold text-slate-900">Prompt Analysis</h1>
        </div>
      </div>
      <div class="p-6">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-blue-600"><%= prompt_analysis.status.titleize %></p>
        <h2 class="mt-3 text-2xl font-black text-slate-950">Analyzing your prompt...</h2>
        <p class="mt-3 text-slate-600">The AI coach is checking clarity, context, constraints, and practical next steps. This page updates automatically.</p>
        <div class="mt-6 h-2 overflow-hidden rounded-full bg-slate-100">
          <div class="h-full w-1/2 animate-pulse rounded-full bg-blue-500"></div>
        </div>
      </div>
    </div>
  <% end %>
</div>
