<div class="rounded-3xl border border-white/10 bg-white/10 p-5">
  <h3 class="text-lg font-bold text-white"><%= title %></h3>

  <% if items.any? %>
    <ul class="mt-4 space-y-3">
      <% items.each do |item| %>
        <li class="rounded-2xl bg-slate-950/70 p-4 text-sm leading-6 text-slate-300"><%= item %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 rounded-2xl border border-dashed border-white/10 p-4 text-sm text-slate-400">No <%= title.downcase %> returned.</p>
  <% end %>
</div>
