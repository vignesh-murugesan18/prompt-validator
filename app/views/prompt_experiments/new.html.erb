<% content_for :title, "A/B Prompt Lab" %>
<% content_for :nav_cta, "Templates" %>

<main class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <header class="text-center">
      <h1 class="font-mono text-3xl font-black tracking-[-0.06em] text-slate-950">A/B Prompt Lab</h1>
      <p class="mx-auto mt-3 max-w-2xl text-sm text-slate-600">Compare multiple prompt variants using the same model settings and see which principles improve.</p>
    </header>

    <section class="mx-auto mt-10 max-w-4xl">
      <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
          <h2 class="font-mono text-sm font-bold text-slate-900">Create an experiment</h2>
        </div>

        <% if @prompt_experiment.errors.any? %>
          <div class="m-4 rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
            <p class="font-semibold">Please fix the following:</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              <% @prompt_experiment.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @prompt_experiment, url: prompt_experiments_path do |form| %>
          <div class="grid gap-4 p-4">
            <div class="grid gap-2">
              <%= form.label :title, "Title (optional)", class: "text-sm font-semibold text-slate-700" %>
              <%= form.text_field :title, placeholder: "e.g. Debug prompt for Rails app", class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" %>
            </div>

            <div class="grid gap-2">
              <%= form.label :goal, "Goal (optional)", class: "text-sm font-semibold text-slate-700" %>
              <%= form.text_area :goal, rows: 3, placeholder: "What are you optimizing for? (clarity, edge cases, speed, safety...)", class: "w-full resize-y rounded-md border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" %>
            </div>

            <div class="grid gap-3 md:grid-cols-[minmax(220px,0.8fr)_1fr]">
              <div class="grid gap-2">
                <%= form.label :ai_model, "Model", class: "text-sm font-semibold text-slate-700" %>
                <%= form.select :ai_model,
                  options_for_select([["Groq Llama 3.1 8B", "llama-3.1-8b-instant"], ["Groq Llama 3.3 70B", "llama-3.3-70b-versatile"], ["Groq Gemma 2 9B", "gemma2-9b-it"]], @prompt_experiment.ai_model),
                  {},
                  class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" %>
              </div>

              <label class="mt-7 flex items-center gap-3 rounded-md bg-white px-2 py-2 text-sm font-medium text-slate-600">
                <%= form.check_box :web_search, class: "size-4 rounded border-slate-300 bg-white text-blue-600 focus:ring-blue-500" %>
                Web search with Perplexity (applies to all variants)
              </label>
            </div>
          </div>

          <div class="border-t border-slate-100 bg-white p-4">
            <h3 class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-slate-500">Prompt variants</h3>
            <div class="mt-3 grid gap-3">
              <% @variants.first(6).each_with_index do |value, index| %>
                <div class="rounded-lg border border-slate-200 bg-white">
                  <div class="border-b border-slate-200 bg-slate-50 px-3 py-2">
                    <p class="font-mono text-xs font-bold text-slate-700">Variant <%= index + 1 %></p>
                  </div>
                  <div class="p-3">
                    <textarea
                      name="prompt_experiment[variants][]"
                      rows="5"
                      class="w-full resize-y border-0 bg-white font-mono text-sm leading-7 text-slate-800 outline-none placeholder:text-slate-300"
                      placeholder="// Paste a prompt variant here..."><%= value %></textarea>
                  </div>
                </div>
              <% end %>
            </div>

            <p class="mt-3 text-xs text-slate-500">Tip: keep variants similar and change one thing at a time for clearer comparisons.</p>
          </div>

          <div class="border-t border-slate-100 px-4 py-5 text-center">
            <%= form.submit "Run Experiment", class: "cursor-pointer rounded-lg bg-blue-500 px-8 py-3 font-mono text-xs font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-600" %>
            <div class="mt-3">
              <%= link_to "Browse templates", prompt_templates_path, class: "text-sm font-semibold text-blue-700 hover:text-blue-800" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</main>

