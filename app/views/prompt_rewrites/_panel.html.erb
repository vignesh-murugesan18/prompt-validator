<% rewrite ||= nil %>
<section class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-5 py-4">
    <h2 class="font-mono text-sm font-bold text-slate-900">AI Auto-Fix</h2>
    <span class="font-mono text-xs text-slate-400"><%= rewrite&.status || "ready" %></span>
  </div>

  <div class="p-5">
    <% if rewrite&.completed? %>
      <div class="grid gap-3">
        <% Array(rewrite.rewrites).each do |row| %>
          <div class="rounded-lg border border-slate-200 bg-white p-4">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-slate-500"><%= row["label"] %></p>
            <p class="mt-2 whitespace-pre-wrap font-mono text-sm leading-7 text-slate-700"><%= row["prompt_text"] %></p>
            <div class="mt-4 flex items-center justify-end">
              <%= link_to "Load into editor", root_path, class: "rounded-md bg-blue-600 px-4 py-2 font-mono text-xs font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-700",
                data: { turbo: false },
                onclick: "localStorage.setItem('draftPromptText', #{row['prompt_text'].to_json});" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-4 flex justify-end">
        <%= button_to "Generate again", prompt_analysis_prompt_rewrite_path(prompt_analysis, strategy: rewrite.strategy), method: :post,
          class: "rounded-md border border-slate-200 bg-white px-4 py-2 font-mono text-xs font-bold text-slate-700 transition hover:bg-slate-50" %>
      </div>
    <% elsif rewrite&.failed? %>
      <div class="rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
        <p class="font-semibold">Rewrite failed.</p>
        <p class="mt-1"><%= rewrite.error_message.presence || "Please try again." %></p>
      </div>
      <div class="mt-4 flex justify-end">
        <%= button_to "Try again", prompt_analysis_prompt_rewrite_path(prompt_analysis, strategy: rewrite.strategy), method: :post,
          class: "rounded-md bg-blue-600 px-4 py-2 font-mono text-xs font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-700" %>
      </div>
    <% elsif rewrite&.processing? || rewrite&.queued? %>
      <p class="text-sm text-slate-600">Generating improved prompt options…</p>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-100">
        <div class="h-full w-1/2 animate-pulse rounded-full bg-blue-500"></div>
      </div>
      <div class="mt-4 text-xs text-slate-400">This usually takes 10–20 seconds.</div>
      <script>
        setTimeout(() => { Turbo.visit("<%= prompt_analysis_prompt_rewrite_path(prompt_analysis, strategy: rewrite.strategy) %>", { frame: "<%= dom_id(prompt_analysis, :rewrites) %>" }) }, 2000)
      </script>
    <% else %>
      <p class="text-sm text-slate-600">Generate rewritten prompts that address the biggest weaknesses automatically.</p>
      <div class="mt-4 flex justify-end">
        <%= button_to "Auto-fix my prompt", prompt_analysis_prompt_rewrite_path(prompt_analysis, strategy: rewrite&.strategy || "default"), method: :post,
          class: "rounded-md bg-blue-600 px-4 py-2 font-mono text-xs font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</section>

