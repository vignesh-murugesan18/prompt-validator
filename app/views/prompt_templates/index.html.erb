<% content_for :title, "Prompt Templates" %>
<% content_for :nav_cta, "New experiment" %>

<main class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="font-mono text-2xl font-black tracking-[-0.05em] text-slate-950">Prompt Templates</h1>
        <p class="mt-2 text-sm text-slate-600">Pick a proven starting point, then analyze and iterate.</p>
      </div>
      <%= link_to "Back to editor", root_path, class: "w-fit rounded-md border border-slate-200 bg-white px-4 py-2 font-mono text-xs font-bold text-slate-700 transition hover:bg-slate-50" %>
    </header>

    <% if @templates.empty? %>
      <div class="mt-8 rounded-lg border border-slate-200 bg-white p-6 text-slate-700 shadow-sm">
        <p class="font-mono text-sm font-bold text-slate-900">No templates yet.</p>
        <p class="mt-2 text-sm text-slate-600">Add templates in <code class="rounded bg-slate-100 px-1.5 py-0.5">db/seeds.rb</code> and re-seed.</p>
      </div>
    <% else %>
      <% @templates.group_by(&:category).each do |category, rows| %>
        <section class="mt-10">
          <h2 class="font-mono text-sm font-black uppercase tracking-[0.25em] text-slate-500"><%= category %></h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <% rows.each do |template| %>
              <article class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md">
                <div class="border-b border-slate-200 px-4 py-3">
                  <h3 class="font-mono text-sm font-bold text-slate-950"><%= template.title %></h3>
                  <% if template.description.present? %>
                    <p class="mt-1 text-sm text-slate-600"><%= template.description %></p>
                  <% end %>
                </div>
                <div class="p-4">
                  <p class="line-clamp-4 whitespace-pre-wrap font-mono text-xs leading-6 text-slate-600"><%= template.prompt_text %></p>
                  <div class="mt-4 flex flex-wrap items-center gap-2">
                    <%= link_to "View", prompt_template_path(template.slug), class: "rounded-md border border-slate-200 bg-white px-3 py-2 font-mono text-[11px] font-bold text-slate-700 transition hover:bg-slate-50" %>
                    <%= link_to "Use in editor", root_path(template: template.slug), class: "rounded-md bg-blue-600 px-3 py-2 font-mono text-[11px] font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-700" %>
                    <span class="ml-auto font-mono text-[11px] font-semibold text-slate-400">
                      <%= template.ai_model.presence || "default model" %><%= template.web_search_default? ? " · web search" : "" %>
                    </span>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    <% end %>
  </div>
</main>

