<% content_for :title, @template.title %>
<% content_for :nav_cta, "Use template" %>

<main class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-slate-500"><%= @template.category %></p>
        <h1 class="mt-2 font-mono text-2xl font-black tracking-[-0.05em] text-slate-950"><%= @template.title %></h1>
        <% if @template.description.present? %>
          <p class="mt-3 text-sm text-slate-600"><%= @template.description %></p>
        <% end %>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "Use in editor", root_path(template: @template.slug), class: "rounded-md bg-blue-600 px-4 py-2 font-mono text-xs font-bold text-white shadow-sm shadow-blue-200 transition hover:bg-blue-700" %>
        <%= link_to "All templates", prompt_templates_path, class: "rounded-md border border-slate-200 bg-white px-4 py-2 font-mono text-xs font-bold text-slate-700 transition hover:bg-slate-50" %>
      </div>
    </header>

    <section class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
        <h2 class="font-mono text-sm font-bold text-slate-900">Template Prompt</h2>
        <p class="font-mono text-xs text-slate-500">
          <%= @template.ai_model.presence || "default model" %><%= @template.web_search_default? ? " · web search" : "" %>
        </p>
      </div>
      <div class="p-5">
        <p class="whitespace-pre-wrap font-mono text-sm leading-7 text-slate-700"><%= @template.prompt_text %></p>
      </div>
    </section>
  </div>
</main>

